    "@tanstack/react-router": "^1.170.46",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/markdown": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
