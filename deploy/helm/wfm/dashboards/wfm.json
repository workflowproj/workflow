          "expr": "sum(rate(wfm_rate_limited_total{namespace=~\"$namespace\", component=~\"$component\"}[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "HTTP",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
