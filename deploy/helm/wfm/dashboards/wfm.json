          },
          "expr": "sum(wfm_sse_subscribers{namespace=~\"$namespace\", component=~\"$component\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Refused (429) / min",
      "id": 6,
