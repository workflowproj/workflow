# Keep the build context small and the layer cache stable.
.git
.github
.dockerignore
Dockerfile
Tiltfile
.ko.yaml
*.md
!web/**/*.md
bin/
dist/
deploy/
docs/
scripts/
coverage.out
**/*.test
**/.env
**/.env.*

# Web build outputs and dependencies are rebuilt inside the image.
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/coverage/

# A locally built UI must not leak into the image; the Dockerfile copies web/dist in.
internal/webui/dist/*
!internal/webui/dist/.gitkeep
